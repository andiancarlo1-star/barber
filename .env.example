# ------------------------------------------------------------------
# Base de datos (PostgreSQL)
# Local con Docker: docker compose up -d
# Owner (migrations): used by migrate service
POSTGRES_USER="navaja"
POSTGRES_PASSWORD="change-me-owner-password"
POSTGRES_DB="navaja"
# App runtime role (least privilege, used by app)
POSTGRES_APP_USER="navaja_app"
POSTGRES_APP_PASSWORD="change-me-app-password-min-24-chars"
DATABASE_URL="postgresql://navaja_app:change-me-app-password-min-24-chars@localhost:5433/navaja?schema=public"
MIGRATE_DATABASE_URL="postgresql://navaja:change-me-owner-password@localhost:5433/navaja?schema=public"

# ------------------------------------------------------------------
# Auth.js
# Genera uno con: openssl rand -base64 32
# ------------------------------------------------------------------
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------
# Sitio
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BUSINESS_TIMEZONE="America/Guatemala"

# ------------------------------------------------------------------
# Correo (SMTP). Si se deja vacío, las notificaciones se guardan en BD
# y se registran en consola (modo desarrollo).
# Compatible con Resend SMTP, SendGrid, Gmail App Password, etc.
# ------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Navaja Barber Studio <citas@navajabarber.gt>"

# ------------------------------------------------------------------
# WhatsApp (opcional). Meta Cloud API o proveedor compatible.
# Si está vacío, las notificaciones WhatsApp quedan en cola (SKIPPED).
# ------------------------------------------------------------------
WHATSAPP_API_URL=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_TEMPLATE_REMINDER=""
WHATSAPP_TEMPLATE_CONFIRMATION=""

# ------------------------------------------------------------------
# Pagos - proveedor activo: MOCK | NEONET
# MOCK es SOLO para desarrollo/demostración. No procesa tarjetas reales.
# ------------------------------------------------------------------
PAYMENT_PROVIDER="MOCK"

# NeoNet (Guatemala) - solicitar afiliación, terminal y credenciales.
# La integración está aislada en src/lib/payments/neonet.ts
# Requiere contrato comercial + certificación del sitio.
NEONET_API_BASE="https://epayserver.neonet.com.gt"
NEONET_CHECKOUT_URL=""
NEONET_AFFILIATION=""
NEONET_TERMINAL=""
NEONET_MERCHANT_ID=""
NEONET_API_USER=""
NEONET_API_PASSWORD=""
NEONET_SIGNING_KEY=""
NEONET_WEBHOOK_SECRET=""

# Secreto para el cron de recordatorios (Authorization: Bearer ...)
CRON_SECRET="change-me-generate-a-long-random-value"

# ------------------------------------------------------------------
# Límite de intentos de reserva (en memoria, por instancia)
# ------------------------------------------------------------------
BOOKING_RATE_LIMIT="10"
